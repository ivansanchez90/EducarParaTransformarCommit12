# Base de datos (coincide con docker-compose.yml)
POSTGRES_USER=educar
POSTGRES_PASSWORD=educar
POSTGRES_DB=educar_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://educar:educar@localhost:5432/educar_db?schema=public

# Servidor
PORT=4000
# Solo si el frontend se sirve desde OTRO dominio (por defecto comparten dominio):
# CORS_ORIGIN=https://app.midominio.com
# PUBLIC_URL=https://api.midominio.com

# Autenticación
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Usuario administrador inicial (lo crea el seed)
SEED_ADMIN_EMAIL=admin@educar.local
SEED_ADMIN_PASSWORD=admin1234

# Avisos push (PWA). Generar una sola vez con: npx web-push generate-vapid-keys
# y usar las mismas claves en todos los deploys (si cambian, las suscripciones
# existentes dejan de funcionar). Sin claves, el push queda apagado.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:direccion@tu-escuela.edu.ar

# Email (Gmail). SMTP_PASS es una "contraseña de aplicación" de Google (Cuenta
# → Seguridad → Verificación en dos pasos → Contraseñas de aplicaciones), no la
# contraseña de la cuenta. Sin usuario y contraseña, el envío queda apagado.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=cuenta@gmail.com
# SMTP_PASS=
# MAIL_FROM="Educar para Transformar <cuenta@gmail.com>"
# Pausa entre los emails de fin de mes, en milisegundos (Gmail corta los muy seguidos)
# EMAIL_PAUSA_MS=1000

# Tareas programadas (emails del último día hábil y del día 20). Poner en false
# si hay más de una instancia del backend y solo una tiene que enviarlos.
# TAREAS_PROGRAMADAS=true

# Alias de la cuenta a la que transfieren las familias (factura, comprobante de
# pago y emails). Vacío = no se muestra.
# BANCO_ALIAS=sanchezoliva
